{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mem-ed-wait-times.example/schemas/er-publication.schema.json",
  "title": "Regional ER public timing observation",
  "description": "One facility and published measure from the separate regional collector. Not a Baptist CV_ED_Wait observation. Collection timestamps do not establish source-update time. Invalid source values are evidence only; they have no usable value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "facility", "metric", "batch_id", "observed_at", "source_url", "source_endpoint", "latency_ms", "status", "reason", "value", "source_value"],
  "properties": {
    "schema_version": {"const": 1},
    "facility": {"type": "string", "minLength": 1},
    "metric": {"enum": ["estimated_wait_range", "arrival_slots", "published_wait", "initial_assessment_target"]},
    "batch_id": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "source_endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
    "latency_ms": {"type": "integer", "minimum": 0, "description": "Monotonic milliseconds spent in this source's HTTP requests, including body transfer and excluding parsing. The five Methodist rows share one page request and one data request; Saint Francis excludes the shared token request."},
    "status": {"enum": ["available", "unavailable", "invalid"]},
    "reason": {"type": ["string", "null"]},
    "value": {},
    "source_value": {"description": "Public evidence used to derive value: selected Methodist department fields; Saint Francis slot rows reduced to the fields the parser reads; Forrest City's trimmed widget text or pledge snippets with the regex matches, kept even when nothing matched. No cookies, CSRF tokens, bearer tokens, patient inputs or HTML."}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "available"}}},
      "then": {"properties": {"reason": {"type": "null"}, "value": {"type": "object"}}},
      "else": {"properties": {"reason": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "invalid"}}},
      "then": {"properties": {"value": {"type": "null"}}}
    },
    {
      "if": {"properties": {"metric": {"const": "estimated_wait_range"}, "status": {"const": "available"}}},
      "then": {"properties": {"value": {"$ref": "#/$defs/range"}}}
    },
    {
      "if": {"properties": {"metric": {"const": "arrival_slots"}, "status": {"enum": ["available", "unavailable"]}}},
      "then": {"properties": {"value": {"$ref": "#/$defs/slots"}}}
    },
    {
      "if": {"properties": {"metric": {"const": "arrival_slots"}, "status": {"const": "unavailable"}}},
      "then": {"properties": {"value": {"properties": {"next_available_at": {"type": "null"}, "available_slots": {"maxItems": 0}, "slots_beyond_window": {"const": 0}}}}}
    },
    {
      "if": {"properties": {"metric": {"const": "arrival_slots"}, "status": {"const": "available"}}},
      "then": {"properties": {"value": {"properties": {"next_available_at": {"type": "string", "format": "date-time"}}}}}
    },
    {
      "if": {"properties": {"metric": {"enum": ["published_wait", "initial_assessment_target"]}, "status": {"const": "available"}}},
      "then": {"properties": {"value": {"$ref": "#/$defs/minutes"}}}
    },
    {
      "if": {"properties": {"metric": {"enum": ["estimated_wait_range", "published_wait", "initial_assessment_target"]}, "status": {"const": "unavailable"}}},
      "then": {"properties": {"value": {"type": "null"}}}
    },
    {
      "if": {"properties": {"metric": {"const": "arrival_slots"}}},
      "then": {"properties": {"source_value": {"type": "array", "items": {"$ref": "#/$defs/slot_row"}}}}
    },
    {
      "if": {"properties": {"metric": {"const": "published_wait"}}},
      "then": {"properties": {"source_value": {"$ref": "#/$defs/widget_evidence"}}}
    },
    {
      "if": {"properties": {"metric": {"const": "initial_assessment_target"}}},
      "then": {"properties": {"source_value": {"$ref": "#/$defs/pledge_evidence"}}}
    }
  ],
  "$defs": {
    "range": {
      "type": "object", "additionalProperties": false,
      "required": ["lower_minutes", "upper_minutes", "lower_bound_only"],
      "properties": {
        "lower_minutes": {"type": "integer", "minimum": 0},
        "upper_minutes": {"type": ["integer", "null"], "minimum": 0},
        "lower_bound_only": {"type": "boolean"}
      },
      "if": {"properties": {"lower_bound_only": {"const": true}}},
      "then": {"properties": {"upper_minutes": {"type": "null"}}},
      "else": {"properties": {"upper_minutes": {"type": "integer"}}}
    },
    "minutes": {
      "type": "object", "additionalProperties": false, "required": ["minutes"],
      "properties": {"minutes": {"type": "integer", "minimum": 0}}
    },
    "slots": {
      "type": "object", "additionalProperties": false,
      "required": ["next_available_at", "available_slots", "slots_beyond_window", "window_start", "window_end", "timezone", "schedule_ids"],
      "properties": {
        "next_available_at": {"type": ["string", "null"], "format": "date-time", "description": "Earliest returned next-time or slot; may be beyond the requested window. Not a guaranteed appointment or a wait duration."},
        "available_slots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "date-time"}, "description": "Returned slots inside the requested window only."},
        "slots_beyond_window": {"type": "integer", "minimum": 0, "description": "Distinct returned slots at or after window_end; counted, not listed, and able to set next_available_at. Slots before window_start fail collection."},
        "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"},
        "timezone": {"const": "America/Chicago"},
        "schedule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "slot_row": {
      "type": "object", "additionalProperties": false,
      "required": ["schedule-id", "appointment-type-id", "times", "next-time"],
      "properties": {
        "schedule-id": {"type": "string", "minLength": 1},
        "appointment-type-id": {"type": "string"},
        "times": {"type": "array", "items": {"type": "string"}},
        "next-time": {"type": ["string", "null"]}
      }
    },
    "widget_evidence": {
      "type": "object", "additionalProperties": false, "required": ["widget_text", "matches"],
      "properties": {
        "widget_text": {"type": "string", "maxLength": 200, "description": "Whitespace-collapsed text of the wait-time-menu widget."},
        "matches": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[+-]?\\d+$"}}
      }
    },
    "pledge_evidence": {
      "type": "object", "additionalProperties": false, "required": ["pledge_snippets", "matches"],
      "properties": {
        "pledge_snippets": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 126}, "description": "Visible page text around each \"pledge\" mention, up to 60 characters on each side."},
        "matches": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^\\d+$"}}
      }
    }
  }
}
